{
  "name": "prism-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify": "node scripts/verify.mjs",
    "deps:outdated": "npm outdated",
    "deps:audit": "npm audit",
    "deps:audit:prod": "npm audit --omit=dev",
    "test:browser": "node scripts/verify-browser.mjs",
    "backup": "tsx server/backupCli.ts",
    "project": "tsx server/projectCli.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.12",
    "@tanstack/react-query": "^5.66.0",
    "fastify": "5.12.8",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "^9.1.2",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.8"
  }
}
